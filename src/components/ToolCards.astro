---
import { href } from '../site';
interface Props {
  exclude?: string;
}
const { exclude } = Astro.props;
const tools = [
  { path: '/lire-facture-factur-x/', title: 'Lire une facture Factur-X', text: 'Affichez le contenu du XML caché dans le PDF : lignes, TVA, IBAN, mentions.' },
  { path: '/valider-factur-x/', title: 'Valider un fichier Factur-X', text: 'Des dizaines de contrôles : calculs, champs obligatoires, PDF/A-3, nouvelles mentions 2026.' },
  { path: '/creer-facture-factur-x/', title: 'Créer une facture Factur-X', text: 'Remplissez un formulaire ou partez de votre PDF : vous obtenez un Factur-X EN 16931.' },
].filter((t) => t.path !== exclude);
---
<div class="grid-3">
  {tools.map((t) => (
    <a class="card tool-card" href={href(t.path)}>
      <h3>{t.title}</h3>
      <p>{t.text}</p>
    </a>
  ))}
</div>
