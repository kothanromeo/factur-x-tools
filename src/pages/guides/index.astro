---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Crumbs from '../../components/Crumbs.astro';
import { breadcrumbSchema, href } from '../../site';

const posts = (await getCollection('guides')).sort((a, b) => +b.data.published - +a.data.published);
const crumbs = [
  { name: 'Accueil', path: '/' },
  { name: 'Guides', path: '/guides/' },
];
const fmt = (d: Date) => d.toLocaleDateString('fr-FR', { day: 'numeric', month: 'long', year: 'numeric' });
---
<Base
  keywords={["guide factur-x", "factur-x explication", "facture électronique", "réforme facturation électronique 2026", "facture électronique 2027", "profils factur-x", "mentions obligatoires facture 2026", "facture électronique auto-entrepreneur", "zugferd", "plateforme agréée"]}
  title="Guides Factur-X et facture électronique"
  description="Comprendre Factur-X, choisir le bon profil, appliquer les nouvelles mentions obligatoires et préparer la facture électronique quand on est auto-entrepreneur. Des guides concrets, exemples XML à l’appui."
  schema={[breadcrumbSchema(Astro.site!, crumbs)]}
>
  <Crumbs items={crumbs} />
  <section class="hero wrap narrow">
    <h1>Guides Factur-X</h1>
    <p class="lead">
      Des explications concrètes sur le format et sur la réforme, écrites par un développeur qui a passé du temps dans les spécifications
      pour que vous n’ayez pas à le faire.
    </p>
  </section>
  <div class="wrap narrow">
    <ul class="post-list">
      {posts.map((p) => (
        <li class="card">
          <a href={href(`/guides/${p.id}/`)}>
            <h2>{p.data.title}</h2>
            <p>{p.data.description}</p>
            <time datetime={p.data.published.toISOString()}>{fmt(p.data.published)}</time>
          </a>
        </li>
      ))}
    </ul>
  </div>
</Base>
